[],[],[],[],[],[],[],[],[],[],[{"type":"text","data":"* विश्व में सर्वाधिक लवणता वान झील (Lake Van टर्की (तुर्की) में पाई जाती है। \n* वान झील की लवणता लगभग 330% (प्रति हजार) या 33% है।"}],[],[
  {"type":"text","data":"प्रवाल (Corals) समुद्री जीव होते हैं, जो छोटे-छोटे पॉलिप्स के समूह से बनते हैं और कैल्शियम कार्बोनेट का कठोर ढांचा बनाते हैं।"},
  {"type":"text","data":"प्रवाल भित्ति समुद्री जीवों द्वारा निर्मित विशाल चूना पत्थर की संरचना होती है, जो हजारों वर्षों में विकसित होती है।"},
  {"type":"text","data":"प्रवाल के विकास के लिए उथला, स्वच्छ, गर्म और अवसाद रहित जल आवश्यक होता है, क्योंकि गंदला जल प्रकाश को अवरुद्ध करता है।"},
  {"type":"text","data":"प्रवाल मुख्यतः उष्ण कटिबंधीय महासागरों में उत्पन्न होते हैं, जहाँ पर्याप्त तापमान और सूर्य का प्रकाश उपलब्ध रहता है।"},
  {"type":"text","data":"प्रवाल जीवों के विकास के लिए 70°F से 80°F तापमान उपयुक्त होता है, जिससे उनके जीवन क्रियाएँ सही रहती हैं।"},
  {"type":"text","data":"प्रवालों के लिए 32‰ से 37‰ के बीच सागरीय लवणता उपयुक्त मानी जाती है, क्योंकि इससे उनका विकास संतुलित रहता है।"},
  {"type":"text","data":"प्रवाल भित्तियाँ सामान्यतः 30° उत्तर से 30° दक्षिण अक्षांशों के बीच पाई जाती हैं, जहाँ समुद्र का जल गर्म होता है।"},
  {"type":"text","data":"तट से दूर स्थित प्रवाल भित्ति को अवरोधक प्रवाल भित्ति कहते हैं, जो तट और भित्ति के बीच लैगून बनाती है।"},
  {"type":"text","data":"एटॉल प्रवाल भित्ति का वृत्ताकार या घोड़े की नाल जैसा आकार होता है, जिसके बीच में लैगून पाया जाता है।"},
  {"type":"text","data":"तटीय भित्ति और स्थल खंड के बीच बने जल क्षेत्र को लैगून कहा जाता है, जो शांत और उथला जल क्षेत्र होता है।"},
  {"type":"text","data":"भू-अवतलन सिद्धांत चार्ल्स डार्विन द्वारा दिया गया, जिसमें समुद्री तल के धीरे-धीरे धंसने की प्रक्रिया बताई गई है।"},
  {"type":"text","data":"हिमानी नियंत्रण सिद्धांत डेली द्वारा दिया गया, जिसमें हिम युग के कारण समुद्र स्तर परिवर्तन को कारण माना गया है।"},
  {"type":"text","data":"ग्रेट बैरियर रीफ विश्व की सबसे बड़ी प्रवाल भित्ति है, जो ऑस्ट्रेलिया के पूर्वी तट के पास स्थित है।"},
  {"type":"text","data":"इसकी लंबाई लगभग 1900 किमी और चौड़ाई लगभग 160 किमी है, जिससे यह विश्व की सबसे बड़ी जीवित संरचना है।"},
  {"type":"text","data":"ग्रेट बैरियर रीफ अवरोधक प्रवाल भित्ति का उदाहरण है, जो तट से दूर स्थित होती है।"},
  {"type":"text","data":"प्रवाल भित्तियाँ समुद्र के उष्णकटिबंधीय वर्षा वनों जैसी होती हैं, क्योंकि इनमें अत्यधिक जैव विविधता होती है।"},
  {"type":"text","data":"विश्व की सबसे बड़ी प्रवाल भित्ति ऑस्ट्रेलिया के तट के पास स्थित है, जिसे ग्रेट बैरियर रीफ कहते हैं।"},
  {"type":"text","data":"'ग्रेट बैरियर रीफ' ऑस्ट्रेलिया महाद्वीप के समीप स्थित है और यह जैव विविधता का प्रमुख केंद्र है।"},
  {"type":"text","data":"कोरल रीफ सामान्यतः कर्क और मकर रेखा के बीच के गर्म तटीय क्षेत्रों में पाई जाती हैं।"},
  {"type":"text","data":"पोर्टब्लेयर के पास की प्रवाल भित्तियाँ मुख्यतः भूमंडलीय ऊष्मन के कारण नष्ट हो रही हैं।"}
